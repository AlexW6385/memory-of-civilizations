{
  "name": "memory-of-civilizations",
  "private": true,
  "type": "module",
  "description": "A small planet of the civilizations of Earth, each a walkable, realistic 3D settlement. The site is static ES modules; Node is only for tests, checks and offline baking.",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "check": "node tools/plan-check.mjs",
    "bake": "node tools/bake.mjs",
    "shot": "node tools/shot.mjs",
    "budget": "node tools/budget.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "walk": "node tools/walk-check.mjs",
    "roads": "node tools/road-check.mjs",
    "audio": "node tools/audio-check.mjs",
    "load": "node tools/load-check.mjs"
  },
  "devDependencies": {
    "pixelmatch": "^6.0.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "three": "0.186.1",
    "three-mesh-bvh": "^0.9.0",
    "world-atlas": "^2.0.2"
  }
}
